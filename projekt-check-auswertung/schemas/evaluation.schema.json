{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projekt-check/evaluation.schema.json",
  "title": "Projekt-Check Neutral Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^PCA-[0-9]{8}-[A-Z0-9]{8}$"},
    "checks": {
      "type": "array",
      "minItems": 37,
      "maxItems": 37,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string"}},
    "neutralFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed_facts", "first_party_claims", "pros", "cons", "open_points", "contradictions", "evidence_refs"],
      "properties": {
        "confirmed_facts": {"$ref": "#/$defs/stringList"},
        "first_party_claims": {"$ref": "#/$defs/stringList"},
        "pros": {"$ref": "#/$defs/stringList"},
        "cons": {"$ref": "#/$defs/stringList"},
        "open_points": {"$ref": "#/$defs/stringList"},
        "contradictions": {"$ref": "#/$defs/stringList"},
        "evidence_refs": {"$ref": "#/$defs/stringList"}
      }
    },
    "perspective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "advantages", "disadvantages", "questions", "recommendations"],
      "properties": {
        "summary": {"type": "string"},
        "advantages": {"$ref": "#/$defs/stringList"},
        "disadvantages": {"$ref": "#/$defs/stringList"},
        "questions": {"$ref": "#/$defs/stringList"},
        "recommendations": {"$ref": "#/$defs/stringList"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "result_status", "neutral_finding", "customer", "company", "academy"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 37},
        "key": {"type": "string"},
        "result_status": {"type": "string", "enum": ["bestaetigt", "eigenaussage", "offen", "widerspruch", "kein_befund", "nicht_relevant"]},
        "neutral_finding": {"$ref": "#/$defs/neutralFinding"},
        "customer": {"$ref": "#/$defs/perspective"},
        "company": {"$ref": "#/$defs/perspective"},
        "academy": {"$ref": "#/$defs/perspective"}
      }
    }
  }
}
