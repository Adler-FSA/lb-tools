{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projekt-check/intake.schema.json",
  "title": "Projekt-Check Intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "submitted_at", "traces"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "language": {"type": "string", "enum": ["de", "en"], "default": "de"},
    "traces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "pattern": "^https?://"}
    },
    "claim": {"type": "string", "maxLength": 3000, "default": ""},
    "source": {"const": "projekt-check-web"}
  }
}
