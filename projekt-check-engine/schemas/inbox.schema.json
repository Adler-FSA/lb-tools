{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projekt-check/inbox.schema.json",
  "title": "Projekt-Check Inbox Mirror",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requests"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "submitted_at", "requested_output", "status", "trace_count", "has_claim"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^PCA-[0-9]{8}-[A-Z0-9]{8}$"},
          "submitted_at": {"type": "string", "format": "date-time"},
          "requested_output": {"type": "string", "enum": ["customer_check", "company_check"]},
          "status": {"type": "string", "enum": ["neu", "geprueft", "gestartet", "abgelehnt", "fehler"]},
          "trace_count": {"type": "integer", "minimum": 1, "maximum": 20},
          "has_claim": {"type": "boolean"},
          "order_status": {"type": "string", "enum": ["unbekannt", "bestaetigt", "offen"]}
        }
      }
    }
  }
}
