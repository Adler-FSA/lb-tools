{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projekt-check/status.schema.json",
  "title": "Projekt-Check Case Status",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "case_id", "state", "created_at", "updated_at", "checks", "documents"],
  "properties": {
    "contract_version": {"const": "1.1"},
    "case_id": {"type": "string", "pattern": "^PCA-[0-9]{8}-[A-Z0-9]{8}$"},
    "state": {"type": "string", "enum": ["angenommen", "wartet_auf_start", "identifizierung", "recherche", "auswertung", "pdf_erstellung", "abgeschlossen", "fehler"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "delivery_document": {"type": ["string", "null"], "enum": ["customer_check", "company_check", null]},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["unresolved", "resolving", "resolved", "insufficient"]},
        "label": {"type": "string"},
        "confidence": {"type": "string", "enum": ["none", "low", "medium", "high"]}
      }
    },
    "overall_rating": {"type": ["string", "null"], "enum": ["GRUEN", "GELB", "GELB-ROT", "ROT", null]},
    "checks": {
      "type": "array",
      "minItems": 37,
      "maxItems": 37,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "key", "workflow_status", "result_status", "evidence_count", "summary", "perspectives"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 37},
          "key": {"type": "string"},
          "workflow_status": {"type": "string", "enum": ["wartet", "laeuft", "abgeschlossen", "fehler"]},
          "result_status": {"type": ["string", "null"], "enum": ["bestaetigt", "eigenaussage", "offen", "widerspruch", "kein_befund", "nicht_relevant", null]},
          "evidence_count": {"type": "integer", "minimum": 0},
          "summary": {"type": "string"},
          "perspectives": {
            "type": "object",
            "additionalProperties": false,
            "required": ["customer", "company", "academy"],
            "properties": {
              "customer": {"$ref": "#/$defs/perspectiveStatus"},
              "company": {"$ref": "#/$defs/perspectiveStatus"},
              "academy": {"$ref": "#/$defs/perspectiveStatus"}
            }
          },
          "started_at": {"type": ["string", "null"]},
          "finished_at": {"type": ["string", "null"]}
        }
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer_check", "company_check", "academy_full_analysis"],
      "properties": {
        "customer_check": {"$ref": "#/$defs/document"},
        "company_check": {"$ref": "#/$defs/document"},
        "academy_full_analysis": {"$ref": "#/$defs/document"}
      }
    },
    "error": {"type": ["string", "null"]}
  },
  "$defs": {
    "perspectiveStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["wartet", "laeuft", "abgeschlossen", "fehler"]},
        "updated_at": {"type": ["string", "null"]}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "url", "filename", "pages", "bytes", "generated_at"],
      "properties": {
        "status": {"type": "string", "enum": ["wartet", "wird_erstellt", "fertig", "fehler"]},
        "url": {"type": "string"},
        "filename": {"type": "string"},
        "pages": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "generated_at": {"type": ["string", "null"]}
      }
    }
  }
}
