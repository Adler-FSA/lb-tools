{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Projekt-Check Laufstatus",
  "type": "object",
  "required": ["case_id", "state", "updated_at", "checks"],
  "properties": {
    "case_id": {"type": "string"},
    "state": {"enum": ["wartet", "laeuft", "abgeschlossen", "fehler"]},
    "updated_at": {"type": "string"},
    "identity": {
      "type": "object",
      "properties": {
        "status": {"enum": ["unresolved", "resolving", "resolved", "failed"]},
        "label": {"type": "string"},
        "confidence": {"type": "string"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 37,
      "maxItems": 37,
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 37},
          "title": {"type": "string"},
          "status": {"enum": ["wartet", "laeuft", "bestaetigt", "offen", "widerspruch", "kein_befund", "nicht_relevant", "fehler", "abgeschlossen"]},
          "summary": {"type": "string"},
          "evidence_count": {"type": "integer", "minimum": 0},
          "started_at": {"type": ["string", "null"]},
          "finished_at": {"type": ["string", "null"]}
        }
      }
    }
  }
}
