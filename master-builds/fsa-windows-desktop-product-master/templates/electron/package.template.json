{
  "name": "{{PACKAGE_NAME}}",
  "version": "1.0.0",
  "private": true,
  "description": "{{PRODUCT_DESCRIPTION}}",
  "main": "main.js",
  "author": "Akademie für finanzielle Souveränität",
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "{{APP_ID}}",
    "productName": "{{PRODUCT_APP_NAME}}",
    "asar": true,
    "files": [
      "main.js",
      "desktop-ux.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "{{SHORTCUT_NAME}}",
      "runAfterFinish": true,
      "installerLanguages": ["de_DE"],
      "artifactName": "{{SETUP_FILENAME}}.${ext}"
    }
  }
}
